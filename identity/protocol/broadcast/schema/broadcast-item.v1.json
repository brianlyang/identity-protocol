{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity/protocol/broadcast/schema/broadcast-item.v1.json",
  "title": "Protocol Broadcast Item v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "broadcast_id",
    "created_at_utc",
    "title",
    "message",
    "severity",
    "requires_ack",
    "scope"
  ],
  "properties": {
    "broadcast_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "expire_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "requires_ack": {
      "type": "boolean"
    },
    "scope": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
