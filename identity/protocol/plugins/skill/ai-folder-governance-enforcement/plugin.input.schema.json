{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity/protocol/plugins/skill/ai-folder-governance-enforcement/plugin.input.schema.json",
  "title": "AI Folder Governance Skill Plugin Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity_id",
    "operation",
    "required_skills"
  ],
  "properties": {
    "identity_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "enum": [
        "activate",
        "update",
        "readiness",
        "e2e",
        "ci",
        "validate",
        "scan",
        "three-plane",
        "inspection",
        "mutation"
      ]
    },
    "required_skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
