      "primary_human_literal": "Identity-Context: ... | Layer-Context: ...",
      "machine_literal": "machine_headstamp / receipt fields",
      "proof_owner": "authoritative proof surface",
      "attestation_mode": "machine_authoritative",
      "next_hop_rule": "consumed by control plane for truth and admission"
    }
  ],
  "three_orders_matrix": [
    {
      "order_id": "processing_order",
      "label": "processing order",
      "applies_to": "v1.6.6 control plane",
      "sequence": [
