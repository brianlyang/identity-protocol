      "sequence": [
        "machine-verify",
        "assistant-visible-inject",
        "next turn re-verify"
      ],
      "not_equivalent_to": "visible line order"
    },
    {
      "order_id": "native_chat_visible_order",
      "label": "native chat visible order",
      "applies_to": "native chat assistant-visible injection",
      "sequence": [
        "Identity-Context",
        "Machine-Verification",
        "body"
      ],
      "not_equivalent_to": "processing order"
    },
    {
      "order_id": "governed_visible_order",
      "label": "governed visible order",
      "applies_to": "governed wrapper or explanatory envelope",
      "sequence": [
        "Display-Headstamp",
        "Machine-Verification",
        "body"
      ],
      "not_equivalent_to": "processing order"
    }
  ],
  "object_literal_mapping": [
    {
      "semantic_object": "display_headstamp",
      "object_layer": "visibility",
      "native_chat_literal": "Identity-Context: ... | Layer-Context: ...",
