      "authority_rule": "admission verdict object for next-hop legality"
    },
    {
      "semantic_object": "identity_context_literal",
      "object_layer": "visible_literal",
      "native_chat_literal": "Identity-Context: ... | Layer-Context: ...",
      "governed_literal": "embedded after Display-Headstamp prefix",
      "authority_rule": "literal projection only; not a separate truth object"
    }
  ],
  "clarity_freeze": {
    "manual_headstamp": "`manual_headstamp` = render_origin tag only; never verdict axis.",
    "excluded_non_blocking": "`EXCLUDED_NON_BLOCKING` only removes blocker aggregation; it never upgrades next-hop admission.",
