        "Machine-Verification",
        "body"
      ],
      "primary_human_literal": "Display-Headstamp: Identity-Context: ... | Layer-Context: ...",
      "machine_literal": "Machine-Verification: ...",
      "proof_owner": "machine_headstamp + headstamp_admission_receipt + controlled-runtime artifacts",
      "attestation_mode": "controlled_runtime_governed_output",
      "next_hop_rule": "strict user-visible next hop still requires PASS_REQUIRED admission"
    },
    {
      "surface_id": "explanatory_host_native_envelope",
      "surface_label": "explanatory host-native",
      "surface_class": "host_native_chat_panel",
      "visible_order": [
        "Display-Headstamp",
        "Machine-Verification",
        "body"
      ],
      "primary_human_literal": "Display-Headstamp: Identity-Context: ... | Layer-Context: ...",
      "machine_literal": "Machine-Verification: verification_source=not_claimed; ...",
      "proof_owner": "explanatory only; governed proof remains external",
      "attestation_mode": "not_claimed_explanatory_only",
      "next_hop_rule": "must remain FAIL_REQUIRED even when display is visible"
    },
    {
      "surface_id": "controlled_runtime_artifact",
      "surface_label": "controlled-runtime artifact",
      "surface_class": "machine_artifact",
