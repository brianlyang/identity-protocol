{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity/protocol/plugins/multimodal-vision-enforcement/plugin.input.schema.json",
  "title": "Multimodal Vision Enforcement Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text",
    "images"
  ],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "mime_type": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
