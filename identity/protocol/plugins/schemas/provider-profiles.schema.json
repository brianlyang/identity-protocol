{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity/protocol/plugins/schemas/provider-profiles.schema.json",
  "title": "Provider Profiles (v1.6.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "contract_id",
    "profiles"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "v1.6.2"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "provider_id",
          "model_id",
          "api_base_env",
          "api_key_env",
          "capabilities",
          "limits",
          "governance"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,63}$"
          },
          "provider_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "api_base_env": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "api_key_env": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vision",
              "tool_calling",
              "structured_json"
            ],
            "properties": {
              "vision": {
                "type": "boolean"
              },
              "tool_calling": {
                "type": "boolean"
              },
              "structured_json": {
                "type": "boolean"
              }
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_images",
              "max_image_mb",
              "max_output_tokens",
              "timeout_ms",
              "max_retries"
            ],
            "properties": {
              "max_images": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "max_image_mb": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "max_output_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "timeout_ms": {
                "type": "integer",
                "minimum": 1000
              },
              "max_retries": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              }
            }
          },
          "governance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "require_https",
              "endpoint_allowlist",
              "pii_policy"
            ],
            "properties": {
              "require_https": {
                "type": "boolean"
              },
              "endpoint_allowlist": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "pii_policy": {
                "type": "string",
                "enum": [
                  "redact_before_send",
                  "allow_raw"
                ]
              }
            }
          }
        }
      }
    }
  }
}
