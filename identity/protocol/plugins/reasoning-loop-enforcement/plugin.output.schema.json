{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reasoning Loop Enforcement Output",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "reasoning_loop_failclose_status",
    "reasoning_runtime_evidence_status",
    "reasoning_enforcement_level",
    "strict_run_id_binding",
    "runtime_report_selection_mode",
    "runtime_report_path",
    "runtime_report_run_id",
    "error_code"
  ],
  "properties": {
    "reasoning_loop_failclose_status": {
      "type": "string",
      "enum": [
        "PASS_REQUIRED",
        "SKIPPED_NOT_REQUIRED",
        "FAIL_REQUIRED"
      ]
    },
    "reasoning_runtime_evidence_status": {
      "type": "string",
      "enum": [
        "PASS_REQUIRED",
        "SKIPPED_NOT_REQUIRED",
        "FAIL_REQUIRED"
      ]
    },
    "reasoning_enforcement_level": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "strict_run_id_binding": {
      "type": "boolean"
    },
    "runtime_report_selection_mode": {
      "type": "string",
      "enum": [
        "prefer_run_id",
        "latest_first"
      ]
    },
    "runtime_report_path": {
      "type": "string"
    },
    "runtime_report_run_id": {
      "type": "string"
    },
    "error_code": {
      "type": "string"
    }
  }
}
